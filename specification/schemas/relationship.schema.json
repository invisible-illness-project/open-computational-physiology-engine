{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w3id.org/ocpe/schema/0.1/relationship.schema.json",
  "title": "OCPE relationship",
  "description": "A typed, directed assertion 'subject PREDICATE object' between OCPE entities, optionally with a functional form, a pointer to a model equation, context of applicability and evidence.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/entity_base"
    }
  ],
  "required": [
    "id",
    "kind",
    "label",
    "subject",
    "predicate",
    "object"
  ],
  "properties": {
    "id": {},
    "kind": {
      "const": "relationship"
    },
    "label": {},
    "definition": {},
    "description": {},
    "aliases": {},
    "status": {},
    "since": {},
    "deprecation": {},
    "evidence": {},
    "provenance": {},
    "external_mappings": {},
    "see_also": {},
    "notes": {},
    "curation_notes": {},
    "subject": {
      "$ref": "common.schema.json#/definitions/entity_ref"
    },
    "predicate": {
      "type": "string",
      "pattern": "^([A-Z][A-Z_]*|ocpe:core/[a-z0-9]+(-[a-z0-9]+)*)$",
      "description": "Predicate token (e.g. REGULATES) or its core CURIE (ocpe:core/regulates)."
    },
    "object": {
      "$ref": "common.schema.json#/definitions/entity_ref"
    },
    "functional_form": {
      "type": "string",
      "description": "Functional form token or CURIE from specification/core/functional-forms.yaml."
    },
    "direction_of_effect": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "non_monotonic",
        "none",
        "unknown"
      ]
    },
    "mathematical_specification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "common.schema.json#/definitions/curie"
        },
        "equations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expression": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "scale"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "scale": {
          "type": "string"
        }
      }
    },
    "applicable_contexts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/context"
      }
    },
    "known_limitations": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
