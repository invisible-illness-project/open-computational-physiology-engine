{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Copyright 2026 The Invisible Illness Project. SPDX-License-Identifier: Apache-2.0.",
  "$id": "https://w3id.org/ocpe/schema/0.1/predicate.schema.json",
  "title": "OCPE relationship predicate",
  "description": "A relationship type in the core predicate vocabulary.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/entity_base"
    }
  ],
  "required": [
    "id",
    "kind",
    "label",
    "token"
  ],
  "properties": {
    "id": {},
    "kind": {
      "const": "predicate"
    },
    "label": {},
    "definition": {},
    "description": {},
    "aliases": {},
    "status": {},
    "since": {},
    "deprecation": {},
    "evidence": {},
    "provenance": {},
    "external_mappings": {},
    "see_also": {},
    "notes": {},
    "curation_notes": {},
    "token": {
      "type": "string",
      "pattern": "^[A-Z][A-Z_]*$"
    },
    "subject_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inverse": {
      "type": "string"
    },
    "causal": {
      "type": "boolean"
    },
    "transitive": {
      "type": "boolean"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
