{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w3id.org/ocpe/schema/0.1/intervention.schema.json",
  "title": "OCPE intervention",
  "description": "A test, protocol, therapy, drug, behaviour or environmental manipulation applied to a physiological system. Protocol descriptions are declarative; executing a protocol in silico is the responsibility of downstream simulators.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/entity_base"
    }
  ],
  "required": [
    "id",
    "kind",
    "label",
    "intervention_type"
  ],
  "properties": {
    "id": {},
    "kind": {
      "const": "intervention"
    },
    "label": {},
    "definition": {},
    "description": {},
    "aliases": {},
    "status": {},
    "since": {},
    "deprecation": {},
    "evidence": {},
    "provenance": {},
    "external_mappings": {},
    "see_also": {},
    "notes": {},
    "curation_notes": {},
    "intervention_type": {
      "type": "string",
      "enum": [
        "diagnostic_protocol",
        "therapeutic_protocol",
        "pharmacological",
        "behavioral",
        "environmental",
        "other"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "mechanism_of_action": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/entity_ref"
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "duration": {
                "$ref": "common.schema.json#/definitions/quantity"
              },
              "settings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {},
                    "unit": {
                      "$ref": "common.schema.json#/definitions/unit_code"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {},
              "unit": {
                "$ref": "common.schema.json#/definitions/unit_code"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "model_representations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/model_representation"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
