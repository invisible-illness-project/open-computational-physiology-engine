{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w3id.org/ocpe/schema/0.1/condition.schema.json",
  "title": "OCPE condition",
  "description": "A disease, syndrome, phenotype, exposure or physiological state that alters physiology. Clinical/physiological claims about the condition are separated from model_representations, which are model-specific hypotheses about how the condition is encoded in a computational model.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/entity_base"
    }
  ],
  "required": [
    "id",
    "kind",
    "label",
    "condition_type"
  ],
  "properties": {
    "id": {},
    "kind": {
      "const": "condition"
    },
    "label": {},
    "definition": {},
    "description": {},
    "aliases": {},
    "status": {},
    "since": {},
    "deprecation": {},
    "evidence": {},
    "provenance": {},
    "external_mappings": {},
    "see_also": {},
    "notes": {},
    "curation_notes": {},
    "condition_type": {
      "type": "string",
      "enum": [
        "disease",
        "syndrome",
        "phenotype",
        "exposure",
        "physiological_state"
      ]
    },
    "abbreviation": {
      "type": "string"
    },
    "parent": {
      "$ref": "common.schema.json#/definitions/curie"
    },
    "diagnostic_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "evidence.schema.json"
            }
          }
        }
      }
    },
    "association_evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "composability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composable_with": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/curie"
          }
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "evidence.schema.json"
          }
        }
      }
    },
    "model_representations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/model_representation"
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
