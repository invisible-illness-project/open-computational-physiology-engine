{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Copyright 2026 The Invisible Illness Project. SPDX-License-Identifier: Apache-2.0.",
  "$id": "https://w3id.org/ocpe/schema/0.1/observation.schema.json",
  "title": "OCPE observation record",
  "description": "Exchange format for a single measured, estimated, derived, simulated or self-reported value of an OCPE quantity. OCPE defines the record format only; it does not store observational data. 'value_kind' makes synthetic (simulated) data and latent-construct estimates explicitly distinguishable from measurements. Records may carry uncertainty, timestamps, method/model provenance and quality flags.",
  "type": "object",
  "required": [
    "quantity",
    "value",
    "unit",
    "value_kind"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "quantity": {
      "$ref": "common.schema.json#/definitions/curie",
      "description": "Variable, derived metric or latent construct being reported."
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "unit": {
      "$ref": "common.schema.json#/definitions/unit_code"
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "description": "Measurement or estimate uncertainty expressed in the record's unit (or in 'uncertainty_unit' when given)."
    },
    "uncertainty_type": {
      "type": "string",
      "enum": [
        "sd",
        "se",
        "ci95_halfwidth",
        "range_halfwidth",
        "unspecified"
      ]
    },
    "uncertainty_unit": {
      "$ref": "common.schema.json#/definitions/unit_code",
      "description": "Unit of the uncertainty value when different from the record's unit; must share its dimension."
    },
    "value_kind": {
      "type": "string",
      "enum": [
        "measured",
        "estimated",
        "derived",
        "simulated",
        "self_reported"
      ]
    },
    "time": {
      "type": "string",
      "description": "ISO 8601 timestamp or interval."
    },
    "subject": {
      "type": "string",
      "description": "Opaque, non-identifying subject identifier."
    },
    "method": {
      "$ref": "common.schema.json#/definitions/entity_ref"
    },
    "model": {
      "$ref": "common.schema.json#/definitions/curie"
    },
    "context": {
      "$ref": "common.schema.json#/definitions/context"
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "flag": {
          "type": "string",
          "enum": [
            "good",
            "questionable",
            "artifact",
            "missing"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "value_kind": {
            "const": "simulated"
          }
        }
      },
      "then": {
        "required": [
          "model"
        ]
      }
    }
  ]
}
